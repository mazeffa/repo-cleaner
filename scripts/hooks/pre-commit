#!/bin/sh
# Docs hygiene gate. Installed via `git config core.hooksPath scripts/hooks` (see README Setup).
# Runs scripts/tools/check_docs.py from the repo root and blocks the commit on failure.
# Bypass in an emergency with `git commit --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
# Probe, don't `command -v`: on Windows `python3` is often the Store alias stub, which is
# found on PATH but exits nonzero with an install prompt.
if python3 -c pass >/dev/null 2>&1; then PY=python3; else PY=python; fi
"$PY" scripts/tools/check_docs.py
if [ -f hooks/selftest.py ]; then "$PY" hooks/selftest.py; fi
