#!/bin/sh
# Docs hygiene gate. Installed via `git config core.hooksPath scripts/hooks` (see README Setup).
# Runs scripts/tools/check_docs.py from the repo root and blocks the commit on failure.
# Bypass in an emergency with `git commit --no-verify`.
set -e
cd "$(git rev-parse --show-toplevel)"
python scripts/tools/check_docs.py
